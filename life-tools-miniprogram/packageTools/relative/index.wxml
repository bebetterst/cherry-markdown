<view class="page fade-rise">
  <view class="page-intro">
    <view class="page-kicker">好算生活</view>
    <view class="page-title">亲戚称呼</view>
    <view class="page-desc">像点菜单一样逐级选择：我 → 谁 → 的谁</view>
  </view>

  <!-- 路径面包屑：可点回退到某一层 -->
  <scroll-view scroll-x class="crumb-scroll" enhanced show-scrollbar="{{false}}">
    <view class="crumbs">
      <view class="crumb {{pathKeys.length===0?'on':''}}" data-index="-1" bindtap="jumpTo">我</view>
      <block wx:for="{{pathLabels}}" wx:key="*this">
        <text class="crumb-sep">›</text>
        <view class="crumb {{index===pathLabels.length-1?'on':''}}" data-index="{{index}}" bindtap="jumpTo">{{item}}</view>
      </block>
    </view>
  </scroll-view>

  <!-- 当前结果摘要（选完一层就给反馈） -->
  <view wx:if="{{preview.title}}" class="preview-card {{preview.empty?'is-empty':''}}">
    <view class="preview-label">{{preview.empty ? '下一步' : '当前称呼'}}</view>
    <view class="preview-title">{{preview.empty ? '请选择下一层关系' : preview.title}}</view>
    <view class="preview-tip">{{preview.tip}}</view>
  </view>

  <view class="step-head">
    <view class="step-title">{{stepTitle}}</view>
    <view class="step-meta">第 {{stepNo}} / 4 层</view>
  </view>

  <!-- 分组列表：大热区，符合拇指操作 -->
  <view class="group-list" wx:if="{{pathKeys.length < 4}}">
    <block wx:for="{{optionGroups}}" wx:key="id">
      <view class="group">
        <view class="group-title">{{item.title}}</view>
        <view class="group-card">
          <view
            class="row pressable"
            wx:for="{{item.items}}"
            wx:for-item="opt"
            wx:key="key"
            data-key="{{opt.key}}"
            data-label="{{opt.label}}"
            bindtap="push"
          >
            <view class="row-main">
              <view class="row-title">{{opt.label}}</view>
              <view class="row-hint">{{opt.hint}}</view>
            </view>
            <view class="row-chevron">›</view>
          </view>
        </view>
      </view>
    </block>
  </view>
  <view wx:else class="limit-tip">已达 4 层上限。可点路径回退，或直接分享当前结果。</view>

  <view class="safe-bottom"></view>

  <!-- 底部固定操作栏 -->
  <view class="dock">
    <button class="dock-btn ghost" bindtap="back" disabled="{{!pathKeys.length}}">回退</button>
    <button class="dock-btn ghost" bindtap="reset">清空</button>
    <button class="dock-btn primary" open-type="share" disabled="{{!canShare}}">分享</button>
    <button class="dock-btn accent" bindtap="toggleFav">{{fav ? '已藏' : '收藏'}}</button>
  </view>
</view>
