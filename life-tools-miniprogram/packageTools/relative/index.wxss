/* 支付宝式：浅底 + 单卡片模块 + 一步一屏 */
.rel-page {
  min-height: 100vh;
  padding: 20rpx 28rpx 220rpx;
  background: #f5f7f6;
}

.step-bar {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  padding: 8rpx 0 20rpx;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d8e3dd;
  transition: all 220ms ease;
}

.step-dot.done {
  background: #1a6b55;
}

.step-dot.current {
  width: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0b3d32, #1a6b55);
}

.chain-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chain {
  display: inline-flex;
  align-items: flex-start;
  gap: 0;
  padding: 4rpx 8rpx 8rpx;
}

.chain-node {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
  opacity: 0.55;
}

.chain-node.on {
  opacity: 1;
}

.node-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #dfe8e2;
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(11, 61, 50, 0.06);
}

.chain-node.on .node-avatar {
  background: linear-gradient(145deg, #0b3d32, #1a6b55);
  color: #fff;
  border-color: transparent;
}

.node-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.chain-line {
  width: 40rpx;
  height: 4rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #c5d4cb, #dfe8e2);
}

.outcome {
  border-radius: 28rpx;
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  transition: background 280ms ease;
}

.outcome--idle {
  background: #fff;
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 50, 0.05);
}

.outcome--hit {
  background:
    radial-gradient(520rpx 220rpx at 100% 0%, rgba(224, 161, 6, 0.22), transparent 58%),
    linear-gradient(155deg, #0b3d32 0%, #1a6b55 65%, #2a8a68 100%);
  color: #fff;
  box-shadow: 0 20rpx 40rpx rgba(11, 61, 50, 0.2);
  animation: resultPop 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.outcome-kicker {
  font-size: 22rpx;
  opacity: 0.75;
}

.outcome--idle .outcome-kicker {
  color: var(--muted);
  opacity: 1;
}

.outcome-title {
  margin-top: 10rpx;
  font-size: 64rpx;
  font-weight: 780;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

.outcome--idle .outcome-title {
  font-size: 40rpx;
  color: #c5cec8;
  font-weight: 600;
}

.outcome-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  opacity: 0.88;
}

.outcome--idle .outcome-tip {
  color: var(--muted);
  opacity: 1;
}

.sheet {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(11, 61, 50, 0.06);
  border: 1rpx solid rgba(11, 61, 50, 0.05);
  animation: fadeRise 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.sheet--done {
  padding: 32rpx 28rpx;
}

.sheet-nav {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 20rpx;
  color: #1a6b55;
  font-size: 26rpx;
  font-weight: 600;
}

.nav-back {
  font-size: 36rpx;
  line-height: 1;
}

.sheet-head {
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 720;
  color: #14241f;
  letter-spacing: 0.5rpx;
}

.sheet-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.cat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.cat-tile {
  min-height: 200rpx;
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f8fbf9 0%, #f0f5f2 100%);
  border: 1rpx solid #e3ebe6;
}

.cat-icon {
  width: 56rpx;
  height: 56rpx;
}

.cat-name {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.cat-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.person-grid {
  display: grid;
  gap: 16rpx;
}

.person-grid.cols-1 {
  grid-template-columns: 1fr;
}

.person-grid.cols-2 {
  grid-template-columns: 1fr 1fr;
}

.person-tile {
  min-height: 120rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: #f3f8f5;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.person-tile:active {
  border-color: rgba(26, 107, 85, 0.35);
  background: #e8f3ed;
}

.person-name {
  font-size: 34rpx;
  font-weight: 720;
  color: var(--brand);
}

.person-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.bottom-space {
  height: 40rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 246, 0) 0%, rgba(245, 247, 246, 0.92) 24%, #f5f7f6 100%);
}

.footer-share {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #0b3d32, #1a6b55);
  box-shadow: 0 16rpx 32rpx rgba(11, 61, 50, 0.22);
}

.footer-share::after {
  border: none;
}

.footer-share[disabled] {
  opacity: 0.35;
  box-shadow: none;
}

.footer-links {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.link {
  color: #1a6b55;
  font-weight: 600;
}

.link.disabled {
  color: #b0bdb5;
  pointer-events: none;
}

.link-sep {
  color: #c5cec8;
}
