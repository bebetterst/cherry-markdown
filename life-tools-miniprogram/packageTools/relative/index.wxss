@import "../_shared.wxss";
.path {
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  background: #e7f0eb;
  border-radius: var(--radius-sm);
  color: var(--brand);
  font-weight: 650;
  margin-bottom: 20rpx;
}
.options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.opt {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(11,61,50,0.07);
  color: var(--brand);
  font-weight: 550;
}
.actions-row {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}
.actions-row button { flex: 1; font-size: 26rpx; min-height: 84rpx; line-height: 84rpx; }
