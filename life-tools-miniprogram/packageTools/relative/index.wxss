.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 180rpx;
}

.page-intro {
  padding: 4rpx 4rpx 8rpx;
}

.page-kicker {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 720;
  color: var(--brand);
}

.page-desc {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.crumb-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.crumbs {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 4rpx;
}

.crumb {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 600;
}

.crumb.on {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}

.crumb-sep {
  color: #9aada3;
  font-size: 28rpx;
  padding: 0 4rpx;
}

.preview-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(500rpx 200rpx at 100% 0%, rgba(224, 161, 6, 0.2), transparent 55%),
    linear-gradient(155deg, #0b3d32, #1a6b55 70%, #2f8f70);
  color: #fff;
  box-shadow: 0 16rpx 32rpx rgba(11, 61, 50, 0.18);
  animation: resultPop 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.preview-card.is-empty {
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.preview-label {
  font-size: 22rpx;
  opacity: 0.78;
}

.preview-card.is-empty .preview-label {
  color: var(--muted);
  opacity: 1;
}

.preview-title {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 760;
  line-height: 1.15;
}

.preview-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.88;
  line-height: 1.5;
}

.preview-card.is-empty .preview-tip {
  color: var(--muted);
  opacity: 1;
}

.step-head {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.step-meta {
  font-size: 22rpx;
  color: var(--muted);
}

.group {
  margin-bottom: 20rpx;
}

.group-title {
  padding: 8rpx 8rpx 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.group-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.row {
  min-height: 104rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-title {
  font-size: 32rpx;
  font-weight: 650;
  color: var(--brand);
}

.row-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.row-chevron {
  color: #9aada3;
  font-size: 40rpx;
  line-height: 1;
}

.limit-tip {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff3d1;
  color: var(--accent-ink);
  font-size: 24rpx;
  line-height: 1.5;
}

.safe-bottom {
  height: 24rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr 1fr 1.2fr 1fr;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid var(--line);
  backdrop-filter: blur(12px);
}

.dock-btn {
  margin: 0;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: 650;
  border-radius: 999rpx;
  border: none;
}

.dock-btn::after {
  border: none;
}

.dock-btn.ghost {
  background: #e7f0eb;
  color: var(--brand);
}

.dock-btn.primary {
  background: linear-gradient(135deg, #c98a00, var(--accent));
  color: #1d1400;
}

.dock-btn.accent {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
}

.dock-btn[disabled] {
  opacity: 0.4;
}
