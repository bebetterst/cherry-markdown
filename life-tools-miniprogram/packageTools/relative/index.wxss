/* 4 栏位选择器：结果 → 栏位 → 候选，无整页平铺、无易坏图片图标 */
.rel-page {
  min-height: 100vh;
  padding: 20rpx 28rpx 220rpx;
  background:
    radial-gradient(600rpx 280rpx at 0% 0%, rgba(26, 107, 85, 0.08), transparent 60%),
    radial-gradient(500rpx 240rpx at 100% 8%, rgba(224, 161, 6, 0.1), transparent 55%),
    #f5f7f6;
}

.outcome {
  border-radius: 28rpx;
  padding: 28rpx 28rpx 30rpx;
  margin-bottom: 24rpx;
}

.outcome--idle {
  background: #fff;
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 50, 0.05);
}

.outcome--hit {
  background:
    radial-gradient(520rpx 220rpx at 100% 0%, rgba(224, 161, 6, 0.22), transparent 58%),
    linear-gradient(155deg, #0b3d32 0%, #1a6b55 65%, #2a8a68 100%);
  color: #fff;
  box-shadow: 0 20rpx 40rpx rgba(11, 61, 50, 0.2);
  animation: resultPop 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.outcome-kicker {
  font-size: 22rpx;
  opacity: 0.75;
}

.outcome--idle .outcome-kicker {
  color: var(--muted);
  opacity: 1;
}

.outcome-title {
  margin-top: 10rpx;
  font-size: 64rpx;
  font-weight: 780;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

.outcome--idle .outcome-title {
  font-size: 40rpx;
  color: #c5cec8;
  font-weight: 600;
}

.outcome-alias {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
}

.outcome--idle .outcome-alias {
  background: #f3f8f5;
  color: var(--brand-2);
}

.outcome-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  opacity: 0.88;
}

.outcome--idle .outcome-tip {
  color: var(--muted);
  opacity: 1;
}

.slot-panel {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 20rpx 28rpx;
  border: 1rpx solid rgba(11, 61, 50, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(11, 61, 50, 0.06);
  margin-bottom: 20rpx;
}

.slot-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.slot-title {
  font-size: 32rpx;
  font-weight: 720;
  color: #14241f;
}

.slot-sub {
  font-size: 24rpx;
  color: var(--muted);
}

.slot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.slot {
  min-height: 168rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  border: 2rpx solid #e3ebe6;
  background: linear-gradient(180deg, #f8fbf9 0%, #f0f5f2 100%);
  position: relative;
  transition: border-color 180ms ease, transform 160ms ease, background 180ms ease;
}

.slot.status-filled {
  background: #fff;
  border-color: rgba(26, 107, 85, 0.28);
}

.slot.status-next {
  border-style: dashed;
  border-color: #1a6b55;
  background: #fff;
  animation: slotPulse 1.8s ease-in-out infinite;
}

.slot.status-locked {
  opacity: 0.45;
  background: #eef2f0;
  border-style: solid;
  border-color: #dde5e0;
}

.slot.active {
  border-color: #0b3d32;
  box-shadow: 0 0 0 4rpx rgba(26, 107, 85, 0.18);
  transform: translateY(-2rpx);
}

@keyframes slotPulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(26, 107, 85, 0);
  }
  50% {
    box-shadow: 0 0 0 6rpx rgba(26, 107, 85, 0.12);
  }
}

.slot-no {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(11, 61, 50, 0.08);
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot.status-filled .slot-no {
  background: #0b3d32;
  color: #fff;
}

.slot-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #0b3d32, #1a6b55);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot.status-empty .slot-badge,
.slot.status-next .slot-badge {
  background: #d8e3dd;
  color: #1a6b55;
}

.slot.status-locked .slot-badge {
  background: #d5ddd8;
  color: #8a9a92;
}

.slot-label {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 720;
  color: var(--brand);
}

.slot.status-locked .slot-label {
  color: #8a9a92;
  font-weight: 600;
}

.slot-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.picker.sheet {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 20rpx 28rpx;
  border: 1rpx solid rgba(11, 61, 50, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(11, 61, 50, 0.06);
  animation: fadeRise 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 720;
  color: #14241f;
}

.picker-close {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a6b55;
  padding: 8rpx 12rpx;
}

.picker-tip {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.opt-group + .opt-group {
  margin-top: 22rpx;
}

.opt-group-title {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.opt-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: calc(50% - 6rpx);
  flex: 1 1 calc(50% - 6rpx);
  max-width: calc(50% - 6rpx);
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: #f3f8f5;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.opt-chip.on {
  border-color: rgba(26, 107, 85, 0.4);
  background: #e8f3ed;
}

.opt-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #0b3d32, #2a8a68);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.opt-name {
  font-size: 28rpx;
  font-weight: 720;
  color: var(--brand);
}

.opt-hint {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.idle-tip {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  padding: 12rpx 0 8rpx;
}

.bottom-space {
  height: 40rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 246, 0) 0%, rgba(245, 247, 246, 0.92) 24%, #f5f7f6 100%);
}

.footer-share {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #0b3d32, #1a6b55);
  box-shadow: 0 16rpx 32rpx rgba(11, 61, 50, 0.22);
}

.footer-share::after {
  border: none;
}

.footer-share[disabled] {
  opacity: 0.35;
  box-shadow: none;
}

.footer-links {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.link {
  color: #1a6b55;
  font-weight: 600;
}

.link.disabled {
  color: #b0bdb5;
  pointer-events: none;
}

.link-sep {
  color: #c5cec8;
}
