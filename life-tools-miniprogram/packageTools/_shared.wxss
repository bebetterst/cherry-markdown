.page-intro {
  padding: 4rpx 4rpx 18rpx;
}

.page-kicker {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 720;
  color: var(--brand);
}

.form-shell {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.actions .action {
  flex: 1;
}
