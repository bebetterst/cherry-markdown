<view class="container">
  <view class="card form">
    <view class="field">
      <text class="field-label">税前月薪（元）</text>
      <input class="field-input" type="digit" value="{{gross}}" bindinput="onGross" />
    </view>
    <view class="field">
      <text class="field-label">五险一金个人缴纳（元/月）</text>
      <input class="field-input" type="digit" value="{{social}}" bindinput="onSocial" />
    </view>
    <view class="field">
      <text class="field-label">专项附加扣除（元/月，可填0）</text>
      <input class="field-input" type="digit" value="{{special}}" bindinput="onSpecial" />
    </view>
    <button class="btn-primary" bindtap="calc">估算税后</button>
  </view>

  <view wx:if="{{result}}" class="result-box">
    <view class="result-label">估算税后月收入（元）</view>
    <view class="result-value">{{result.netText}}</view>
    <view class="result-meta">估算个税约 {{result.taxText}} 元/月</view>
    <view class="result-meta">年估算个税约 {{result.annualText}} 元</view>
  </view>
  <view class="actions" wx:if="{{result}}">
    <button class="btn-ghost" open-type="share">分享结果</button>
    <button class="btn-ghost" bindtap="toggleFav">{{fav ? '已收藏' : '收藏工具'}}</button>
  </view>
  <view class="hint">{{hint}}</view>
</view>
