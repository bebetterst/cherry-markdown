page {
  --brand: #0b3d32;
  --brand-2: #1a6b55;
  --brand-3: #2f8f70;
  --accent: #e0a106;
  --accent-ink: #8a6200;
  --accent-soft: #fff3d1;
  --bg: #eef4f0;
  --card: rgba(255, 255, 255, 0.92);
  --ink: #14241f;
  --muted: #6a7a72;
  --line: rgba(11, 61, 50, 0.08);
  --danger: #c2410c;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --shadow: 0 12rpx 36rpx rgba(11, 61, 50, 0.07);
  --nav-h: 0rpx;

  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  background-color: var(--bg);
  background-image:
    radial-gradient(1200rpx 700rpx at 0% -8%, rgba(224, 161, 6, 0.14), transparent 52%),
    radial-gradient(900rpx 600rpx at 100% 0%, rgba(26, 107, 85, 0.14), transparent 48%),
    linear-gradient(rgba(11, 61, 50, 0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(11, 61, 50, 0.025) 1rpx, transparent 1rpx);
  background-size: auto, auto, 48rpx 48rpx, 48rpx 48rpx;
  background-attachment: fixed;
}

view,
text,
input,
button,
textarea,
picker {
  box-sizing: border-box;
}

.container {
  padding: 28rpx 28rpx 56rpx;
  min-height: 100vh;
}

.fade-rise {
  animation: fadeRise 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes fadeRise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.brand-mark {
  font-family: "HaosuanDisplay", "Songti SC", "STSong", serif;
  font-size: 56rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: var(--brand);
  line-height: 1.15;
}

.brand-sub {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
}

.section-head {
  margin: 40rpx 0 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 680;
  color: var(--brand);
  letter-spacing: 0.5rpx;
}

.section-link {
  color: var(--brand-2);
  font-size: 24rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
  backdrop-filter: blur(12px);
}

.pressable {
  transition: transform 160ms ease, opacity 160ms ease;
}

.pressable:active {
  transform: scale(0.98);
  opacity: 0.88;
}

.btn-primary {
  min-height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 650;
  font-size: 30rpx;
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(11, 61, 50, 0.18);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.92;
  transform: scale(0.985);
}

.btn-ghost {
  min-height: 84rpx;
  line-height: 84rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--brand);
  border: 2rpx solid rgba(11, 61, 50, 0.16);
  border-radius: 999rpx;
  font-weight: 600;
}

.btn-ghost::after {
  border: none;
}

.btn-share {
  background: linear-gradient(135deg, #c98a00, var(--accent));
  color: #1d1400;
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(224, 161, 6, 0.25);
}

.btn-share::after {
  border: none;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.field-input {
  width: 100%;
  min-height: 92rpx;
  padding: 0 28rpx;
  background: var(--soft, #e7f0eb);
  background: #e7f0eb;
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  font-size: 30rpx;
  color: var(--ink);
}

.field-input:focus {
  border-color: rgba(26, 107, 85, 0.35);
  background: #fff;
}

.seg {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 6rpx;
  background: #e7f0eb;
  border-radius: 999rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 18rpx;
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 550;
  transition: all 180ms ease;
}

.seg-item.active {
  background: #fff;
  color: var(--brand);
  box-shadow: 0 6rpx 16rpx rgba(11, 61, 50, 0.1);
}

.result-box {
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  background:
    radial-gradient(600rpx 240rpx at 100% 0%, rgba(224, 161, 6, 0.22), transparent 55%),
    linear-gradient(155deg, #0b3d32 0%, #1a6b55 62%, #2f8f70 100%);
  color: #fff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(11, 61, 50, 0.22);
}

.result-box.result-pop {
  animation: resultPop 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes resultPop {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.result-label {
  opacity: 0.78;
  font-size: 24rpx;
}

.result-value {
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 720;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.result-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.hint {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.empty {
  padding: 72rpx 24rpx;
  text-align: center;
  color: var(--muted);
}

.empty-title {
  margin-top: 12rpx;
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 650;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.icon-bubble {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #e7f0eb;
}

.pulse-soft {
  animation: pulseSoft 2.4s ease-in-out infinite;
}

@keyframes pulseSoft {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.03);
  }
}
