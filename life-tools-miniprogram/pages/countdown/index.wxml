<view class="container fade-rise">
  <view wx:if="{{focus}}" class="focus-hero">
    <view class="focus-kicker">好算生活 · 倒数日</view>
    <image class="focus-icon" src="{{focus.icon}}" mode="aspectFit" />
    <view class="focus-title">{{focus.title}}</view>
    <view class="focus-count {{focus.delta < 0 ? 'passed' : ''}} pulse-soft">
      <text class="num">{{focus.abs}}</text>
      <text class="unit">{{focus.delta < 0 ? '天前' : (focus.delta === 0 ? '就是今天' : '天后')}}</text>
    </view>
    <view class="focus-date">{{focus.date}}</view>
  </view>

  <view wx:else class="hero">
    <view class="brand-mark">倒数日</view>
    <view class="brand-sub">把想奔赴的日子，放在眼前</view>
  </view>

  <view class="day-list">
    <view
      class="day-card pressable {{index === 0 ? 'is-focus' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
    >
      <view class="day-top">
        <image class="day-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="day-main">
          <view class="day-title">{{item.title}}</view>
          <view class="day-date">{{item.date}}</view>
        </view>
        <view class="day-count {{item.delta < 0 ? 'passed' : ''}}">
          <text class="num">{{item.abs}}</text>
          <text class="unit">{{item.delta < 0 ? '天前' : (item.delta === 0 ? '今天' : '天后')}}</text>
        </view>
      </view>
      <view class="day-actions">
        <button class="btn-share mini" size="mini" data-item="{{item}}" open-type="share" bindtap="onShareTap">分享给朋友</button>
        <button class="btn-ghost mini danger" size="mini" data-id="{{item.id}}" bindtap="onDelete">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <view class="empty-title">还没有倒数日</view>
    <view class="empty-desc">记下高考、纪念日或还款日，每天打开都有盼头</view>
  </view>

  <view class="fab-wrap">
    <button class="btn-primary fab" bindtap="onAdd">新建倒数日</button>
  </view>

  <view wx:if="{{showModal}}" class="mask" bindtap="closeModal">
    <view class="modal card" catchtap="noop">
      <view class="modal-handle"></view>
      <view class="modal-title">新建倒数日</view>
      <view class="field">
        <text class="field-label">标题</text>
        <input class="field-input" placeholder="例如：高考 / 结婚纪念日" value="{{form.title}}" bindinput="onTitle" focus="{{showModal}}" />
      </view>
      <view class="field">
        <text class="field-label">日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDate">
          <view class="field-input picker">{{form.date || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">图标</text>
        <view class="symbol-row">
          <view
            wx:for="{{symbols}}"
            wx:key="id"
            class="symbol {{form.symbol === item.id ? 'on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSymbol"
          >
            <image src="{{item.icon}}" mode="aspectFit" />
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
      <button class="btn-primary" bindtap="save">保存</button>
    </view>
  </view>
</view>
