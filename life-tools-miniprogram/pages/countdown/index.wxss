.focus-hero {
  padding: 28rpx 8rpx 12rpx;
  text-align: center;
}

.focus-kicker {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.focus-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
}

.focus-count {
  margin-top: 18rpx;
  color: var(--accent);
}

.focus-count .num {
  font-size: 120rpx;
  font-weight: 780;
  line-height: 1;
  letter-spacing: -2rpx;
}

.focus-count .unit {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--accent-ink);
}

.focus-count.passed,
.focus-count.passed .unit {
  color: var(--muted);
}

.focus-date {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.hero {
  padding: 8rpx;
  text-align: center;
}

.day-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 140rpx;
}

.day-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.day-card.is-focus {
  border-color: rgba(224, 161, 6, 0.35);
  background: linear-gradient(180deg, rgba(255, 243, 209, 0.55), rgba(255, 255, 255, 0.95));
}

.day-top {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.day-main {
  flex: 1;
}

.day-title {
  font-size: 32rpx;
  font-weight: 680;
  color: var(--brand);
}

.day-date {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.day-count {
  text-align: right;
  color: var(--accent);
}

.day-count.passed {
  color: var(--muted);
}

.day-count .num {
  display: block;
  font-size: 48rpx;
  font-weight: 760;
  line-height: 1.05;
}

.day-count .unit {
  font-size: 22rpx;
}

.day-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.mini {
  margin: 0;
  padding: 0 22rpx;
  line-height: 60rpx;
  min-height: 60rpx;
  font-size: 22rpx;
  flex: 1;
}

.danger {
  color: var(--danger) !important;
  border-color: rgba(194, 65, 12, 0.25) !important;
}

.fab-wrap {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.fab {
  width: 100%;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 24, 18, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
  animation: fadeRise 220ms ease both;
}

.modal {
  width: 100%;
  padding: 18rpx 28rpx 48rpx;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  animation: resultPop 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.modal-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(11, 61, 50, 0.15);
  margin: 0 auto 18rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 720;
  color: var(--brand);
  margin-bottom: 20rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.emoji-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #e7f0eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  text-align: center;
  line-height: 76rpx;
}

.emoji.on {
  background: var(--accent-soft);
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.tint-countdown {
  background: #fff3d1;
}
