<view class="container fade-rise">
  <view class="profile">
    <view class="profile-badge">算</view>
    <view class="profile-main">
      <view class="brand-mark">好算生活</view>
      <view class="brand-sub">v{{version}} · 本地优先，隐私友好</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="stat-num">{{favCount}}</view>
      <view class="stat-label">收藏</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{historyCount}}</view>
      <view class="stat-label">最近使用</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{dayCount}}</view>
      <view class="stat-label">倒数日</view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">收藏的工具</view>
  </view>
  <view wx:if="{{!favorites.length}}" class="empty soft">
    <view class="empty-desc">在工具结果页点「收藏」，下次更快打开</view>
  </view>
  <view class="list">
    <view
      class="list-item pressable"
      wx:for="{{favorites}}"
      wx:key="id"
      data-path="{{item.path}}"
      data-tab="{{item.tab}}"
      bindtap="go"
    >
      <view class="icon-bubble">{{item.emoji}}</view>
      <text class="name">{{item.name}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">最近使用</view>
  </view>
  <view wx:if="{{!history.length}}" class="empty soft">
    <view class="empty-desc">用过的工具会出现在这里</view>
  </view>
  <view class="list">
    <view
      class="list-item pressable"
      wx:for="{{history}}"
      wx:key="id"
      data-path="{{item.path}}"
      data-tab="{{item.tab}}"
      bindtap="go"
    >
      <view class="icon-bubble">{{item.emoji}}</view>
      <text class="name">{{item.name}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">使用说明</view>
  </view>
  <view class="note">
    <view class="note-item">计算结果仅供参考，房贷 / 个税 / 退休请以官方口径为准。</view>
    <view class="note-item">倒数日与历史默认保存在本机，清除缓存会丢失。</view>
    <view class="note-item">开通流量主后，在 config/ads.js 填入广告单元 ID 即可变现。</view>
  </view>
</view>
