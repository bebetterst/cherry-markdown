.hero {
  position: relative;
  padding: 18rpx 8rpx 8rpx;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(224, 161, 6, 0.22), transparent 68%);
  pointer-events: none;
}

.search-shell {
  margin-top: 28rpx;
  min-height: 96rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.search-glyph {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
}

.search-ph {
  color: #92a39a;
}

.search-clear {
  color: var(--brand-2);
  font-size: 24rpx;
  padding: 8rpx 10rpx;
}

.chips-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.chips {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.chip {
  display: inline-flex;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(11, 61, 50, 0.07);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 550;
}

.continue,
.day-peek {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.continue-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.continue-kicker {
  font-size: 22rpx;
  color: var(--muted);
}

.continue-name,
.day-peek-title {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 680;
  color: var(--brand);
}

.continue-cta {
  color: var(--brand-2);
  font-size: 26rpx;
  font-weight: 600;
}

.day-peek-count {
  text-align: right;
  color: var(--accent-ink);
}

.day-peek-count .num {
  display: block;
  font-size: 52rpx;
  font-weight: 760;
  line-height: 1;
  color: var(--accent);
}

.day-peek-count .unit {
  font-size: 22rpx;
}

.list {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.list-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.list-item:last-child {
  border-bottom: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 680;
  color: var(--brand);
}

.tool-desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.arrow {
  color: #9aada3;
  font-size: 40rpx;
  line-height: 1;
}
